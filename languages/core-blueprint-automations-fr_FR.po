#: src/Admin/ValidationPresenter.php:40
#, php-format
msgid ""
"Capability schema changed from version %1$s to %2$s. Review this step before "
"enabling it again."
msgstr ""
"Le schéma de la capacité est passé de la version %1$s à %2$s. Vérifiez cette "
"étape avant de la réactiver."

#: src/Admin/ValidationPresenter.php:44
msgid "A workflow step uses the wrong capability type."
msgstr "Une étape du workflow utilise le mauvais type de capacité."

#. translators: %s: input field.
#: src/Admin/ValidationPresenter.php:47
#, php-format
msgid "Required input “%s” is not connected."
msgstr "L’entrée requise « %s » n’est pas connectée."

#. translators: %s: input field.
#: src/Admin/ValidationPresenter.php:52
#, php-format
msgid "Input “%s” is no longer declared by this capability."
msgstr "L’entrée « %s » n’est plus déclarée par cette capacité."

#: src/Admin/ValidationPresenter.php:55
msgid "A binding points to a workflow step that no longer exists."
msgstr "Une liaison pointe vers une étape du workflow qui n’existe plus."

#: src/Admin/ValidationPresenter.php:56
msgid "A binding points to a step that runs later in the workflow."
msgstr "Une liaison pointe vers une étape exécutée plus tard dans le workflow."

#: src/Admin/ValidationPresenter.php:57
msgid "A binding points to an output field that no longer exists."
msgstr "Une liaison pointe vers un champ de sortie qui n’existe plus."

#: src/Admin/ValidationPresenter.php:58
msgid "A binding value does not match the declared input type."
msgstr "Une valeur de liaison ne correspond pas au type d’entrée déclaré."

#: src/Admin/ValidationPresenter.php:59
msgid "Triggers cannot declare input bindings."
msgstr "Les déclencheurs ne peuvent pas déclarer de liaisons d’entrée."

#: src/Admin/ValidationPresenter.php:60
msgid "A condition uses an unsupported operator."
msgstr "Une condition utilise un opérateur non pris en charge."

#: src/Admin/ValidationPresenter.php:61
msgid "A condition has the wrong number of operands for its operator."
msgstr "Une condition a un nombre d’opérandes incorrect pour son opérateur."

#: src/Admin/ValidationPresenter.php:62
msgid "A condition compares incompatible value types."
msgstr "Une condition compare des types de valeurs incompatibles."

#: src/Admin/ValidationPresenter.php:63
msgid ""
"Sensitive inputs cannot contain persisted literal values. Connect them to a "
"prior workflow output instead."
msgstr ""
"Les entrées sensibles ne peuvent pas contenir de valeurs littérales "
"enregistrées. Connectez-les plutôt à une sortie antérieure du workflow."

#: src/Admin/ValidationPresenter.php:64
